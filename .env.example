# Copy to .env and edit. .env is git-ignored.
# Production fail-fast: backend refuses to start without JWT_SECRET.

APP_ENV=development
APP_DEBUG=1

# Auth — CHANGE THIS IN PRODUCTION (min 32 bytes recommended)
JWT_SECRET=dev-secret-change-me-please-32bytes-min
JWT_ALGO=HS256
JWT_EXPIRY_DAYS=7

# Registration: 1 = open (dev), 0 = closed (production default)
OPEN_REGISTRATION=1

# Demo không có SMTP: 1 = tự xác minh email lúc đăng ký để đăng nhập lại được ngay.
# Production (đã có SMTP) để 0.
AUTO_VERIFY_EMAIL=0

# CORS allowlist (comma-separated). No wildcards.
# Khi chạy sau Caddy cùng origin thì CORS gần như không dùng, nhưng vẫn cần
# cho dev Vite (5173) gọi thẳng API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Public base URL dùng để dựng link trong email xác minh/reset.
# Bỏ trống -> lấy theo request. Sau reverse proxy phải set tường minh.
APP_URL=http://localhost:8000

# Google OAuth External (optional). Keep client secret backend-only.
# Phải điền đủ cả 3 dòng hoặc bỏ trống cả 3.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Email (SMTP) — verification/reset fail closed with HTTP 503 until configured.
# Tokens are never returned in API responses.
# EMAIL_SMTP_HOST=smtp.example.com
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_USER=noreply@example.com
# EMAIL_SMTP_PASS=change-me
# EMAIL_FROM=noreply@example.com

# Rate limit: chỉ tin X-Forwarded-For khi peer kết nối là proxy trong danh sách.
# docker-compose đặt Caddy ở IP tĩnh 172.28.0.10 (subnet 172.28.0.0/16).
# RATE_LIMIT_TRUSTED_PROXIES=172.28.0.10

# SQLite file. Default data/spends.db (docker: /app/data/spends.db trong volume).
# DATABASE_PATH=data/spends.db

# Domain cho Caddy (chỉ docker compose đọc). ":80" = HTTP thuần,
# "quanhta.example.com" = Caddy tự lấy cert Let's Encrypt.
# SITE_ADDRESS=:80
