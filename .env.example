# Copy to .env and edit. .env is git-ignored.
# Production fail-fast: backend refuses to start without JWT_SECRET.

APP_ENV=development
APP_DEBUG=1

# Auth — CHANGE THIS IN PRODUCTION (min 32 bytes recommended)
JWT_SECRET=dev-secret-change-me-please-32bytes-min
JWT_ALGO=HS256
JWT_EXPIRY_DAYS=7

# Registration: 1 = open (dev), 0 = closed (production default)
OPEN_REGISTRATION=1

# CORS allowlist (comma-separated). No wildcards.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Public base URL dùng để dựng link trong email xác minh/reset (không có schema -> localhost:8000)
APP_URL=http://localhost:8000

# Google OAuth External (optional). Keep client secret backend-only.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
# Gmail metadata connection is a separate OAuth flow. These may reuse the same
# Google Cloud client, but the redirect URI must be registered separately.
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REDIRECT_URI=http://localhost:8000/auth/gmail/callback
# Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# GMAIL_TOKEN_ENCRYPTION_KEY=
# Pub/Sub topic resource, e.g. projects/my-project/topics/gmail-events
# GMAIL_PUBSUB_TOPIC=
# GMAIL_PUBSUB_VERIFICATION_TOKEN=
# GMAIL_PUBSUB_AUDIENCE=
# Optional metadata-only filters (comma-separated; no email body is read).
# GMAIL_PAYMENT_SENDER_FILTERS=bank.example,payment.example
# GMAIL_PAYMENT_SUBJECT_FILTERS=payment,paid,thanh toan

# Upload limits
MAX_UPLOAD_BYTES=10485760
MAX_PDF_PAGES=20

# Storage
STORAGE_DIR=./data/storage

# Vision model cho bộ nhớ nhận diện mua hàng (tùy chọn). Mặc định:
# models/mobilenetv3_embed.onnx — xuất bằng scripts/export_vision_model.py.
# Thiếu file thì bộ nhớ tự dùng dHash + OCR, không cần dòng này.
# VISION_MODEL_PATH=./models/mobilenetv3_embed.onnx

# LLM (optional — regex/OCR work without it)
# LLM_MODE=fill
# LLM_API_KEY=
# OPENAI_API_KEY=
# Email (SMTP) — verification/reset endpoints fail closed with HTTP 503 until configured.
# Tokens are never returned in API responses.
# Cùng block này được dùng để gửi email nhắc chụp hóa đơn cho giao dịch chưa có bill
# (best-effort: không cấu hình thì bỏ qua im lặng, chỉ hiện card trên Dashboard).
# EMAIL_SMTP_HOST=smtp.example.com
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_USER=noreply@example.com
# EMAIL_SMTP_PASS=change-me
# EMAIL_FROM=noreply@example.com

# IMAP poller (optional) — đọc email thông báo giao dịch ngân hàng/ví tự động.
# Bật khi điền IMAP_HOST + IMAP_USER. Gmail: imap.gmail.com:993 + App Password.
# IMAP_HOST=imap.gmail.com
# IMAP_PORT=993
# IMAP_USER=ban@gmail.com
# IMAP_PASS=app-password
# IMAP_FOLDER=INBOX
# IMAP_INTERVAL_SECONDS=60
# Gắn From-address -> username (rỗng: mọi email gán mọi user verified)
# IMAP_USER_MAP=ban@gmail.com,linh

# Web Push (thông báo native trên điện thoại) — sinh key:
#   python3 scripts/gen_vapid_keys.py
# rồi dán 3 dòng in ra vào đây và restart backend.
# VAPID_PUBLIC_KEY=BEl...
# VAPID_PRIVATE_KEY=./vapid_private.pem
# VAPID_SUBJECT=mailto:ban@example.com

# Billing — production MUST NOT use mock
# BILLING_PROVIDER=mock   # dev only; production: stripe|paddle — production fail-fast warns if mock remains
# BILLING_WEBHOOK_SECRET=whsec_...  # set per provider; do NOT use mock secret in production

