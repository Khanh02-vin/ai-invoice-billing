# Caddy phục vụ React SPA + proxy API sang backend FastAPI.
#
# SITE_ADDRESS quyết định chế độ chạy:
#   ":80"                  -> HTTP thuần (LAN/dev)
#   "quanhta.example.com"  -> Caddy TỰ lấy + gia hạn cert Let's Encrypt (cần port 80/443 mở)
#
# Frontend gọi API bằng path tương đối (/auth, /places, /spends, /discover) nên
# chỉ cần cùng origin — không cần CORS, không cần VITE_API_BASE lúc build.
{$SITE_ADDRESS::80}

# API -> backend (giữ nguyên path; backend không có prefix).
# Phải liệt kê cả path gốc không có hậu tố (vd /places, /spends):
# `path /places/*` KHÔNG khớp `/places`, và route rơi vào SPA fallback trả
# index.html → frontend nhận HTML thay vì JSON rồi crash.
@api path /auth /auth/* /places /places/* /spends /spends/* /discover /discover/* /health /ready /docs /redoc /openapi.json
handle @api {
	# docker-compose: backend:8000 (mặc định)
	reverse_proxy {$BACKEND_UPSTREAM:backend:8000}
}

# Asset có hash trong tên (Vite) -> cache vĩnh viễn
@assets path /assets/*
header @assets Cache-Control "public, max-age=31536000, immutable"

# SPA: mọi path khác trả index.html
handle {
	root * /srv
	try_files {path} /index.html
	file_server
}

encode gzip
